# Required upstream JSON endpoints
API_1_URL=https://example.com/api/one
API_2_URL=https://example.com/api/two

# JSON field names and input ranges. Nested fields use dots, e.g. data.measurement.
API_1_VALUE_PATH=value
API_1_MIN=0
API_1_MAX=100
API_2_VALUE_PATH=value
API_2_MIN=0
API_2_MAX=100

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173
